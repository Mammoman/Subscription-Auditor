# The app uses a Postgres database via Prisma.
#
# Production (Vercel): when you create a Vercel Postgres database and connect it
# to the project, Vercel injects the connection string automatically — no manual
# entry needed. If your integration names it POSTGRES_PRISMA_URL instead, add a
# DATABASE_URL variable in Vercel pointing at the same (pooled) connection string.
#
# Local development: copy this file to .env and paste your Vercel Postgres
# connection string here. Then `npm run dev` auto-creates the table.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Optional: Mono bank-connect (mono.co). Leave unset to keep it dormant — the
# "Connect your bank" button only appears when the public key is present. Get
# sandbox keys from the Mono dashboard (test mode is free).
# MONO_SECRET_KEY="test_sk_xxx"                 # server-only, never exposed
# NEXT_PUBLIC_MONO_PUBLIC_KEY="test_pk_xxx"     # safe for the browser
