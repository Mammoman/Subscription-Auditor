# Local development needs NO env vars — the app uses a local SQLite file
# (prisma/dev.db) automatically.

# Production (Vercel + Turso): set these two so the app connects to your Turso
# cloud database instead of a local file. Get them from the Turso CLI:
#   turso db show subscription-auditor --url
#   turso db tokens create subscription-auditor
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
