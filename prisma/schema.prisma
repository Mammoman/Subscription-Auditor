generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String // bcrypt hash
  name         String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime
  merchantRaw        String
  merchantNormalized String
  amount             Float
  category           String?
  direction          String   @default("debit") // debit (money out) | credit (money in)
  status             String   @default("active") // active | cancelled (local-only)
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([merchantNormalized])
}
